<UserControl x:Class="Prosmotr.Views.TorrentStreamView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF"
             xmlns:vm="clr-namespace:Prosmotr.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:TorrentStreamViewModel}"
             PreviewKeyDown="OnPreviewKeyDown"
             Focusable="True">

    <Grid x:Name="VideoHost" Background="Black" ClipToBounds="True">

        <!-- ============ Фаза загрузки ============ -->
        <Grid x:Name="LoadingPanel" Background="Black"
              Visibility="{Binding IsReadyToPlay, Converter={StaticResource InverseBoolToVis}}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="560" Margin="24"
                        TextElement.Foreground="White">
                <ui:SymbolIcon Symbol="Video24" FontSize="64" Opacity="0.6" HorizontalAlignment="Center" />
                <TextBlock x:Name="TitleText" Text="{Binding Name}" FontSize="20" FontWeight="SemiBold"
                           TextAlignment="Center" TextWrapping="Wrap" Margin="0,20,0,6" />
                <TextBlock Text="{Binding StatusText}" Opacity="0.75" TextAlignment="Center" />

                <ProgressBar Height="6" Maximum="100" Value="{Binding DownloadedPercent, Mode=OneWay}"
                             Margin="0,24,0,8">
                    <ProgressBar.Style>
                        <Style TargetType="ProgressBar">
                            <Setter Property="IsIndeterminate" Value="False" />
                            <Style.Triggers>
                                <!-- Пока ищем пиров (метаданные не получены) — бегущая полоса -->
                                <DataTrigger Binding="{Binding IsSearching}" Value="True">
                                    <Setter Property="IsIndeterminate" Value="True" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ProgressBar.Style>
                </ProgressBar>
                <TextBlock TextAlignment="Center" Opacity="0.85" FontSize="13">
                    <Run Text="{Binding DownloadedPercent, Mode=OneWay, StringFormat={}{0:0}%}" />
                    <Run Text=" · " />
                    <Run Text="{Binding SpeedText, Mode=OneWay}" />
                    <Run Text=" ↓" />
                    <Run Text=" · " />
                    <Run Text="{Binding UploadText, Mode=OneWay}" />
                    <Run Text=" ↑" />
                    <Run Text=" · " />
                    <Run Text="{Binding PeersText, Mode=OneWay}" />
                    <Run Text=" пиров" />
                </TextBlock>
                <TextBlock Text="{Binding EtaText}" TextAlignment="Center" Opacity="0.6" FontSize="12"
                           Margin="0,4,0,0" />

                <TextBlock Text="{Binding ErrorMessage}" Foreground="#FF8F8F" TextAlignment="Center"
                           TextWrapping="Wrap" Margin="0,12,0,0"
                           Visibility="{Binding IsError, Converter={StaticResource BoolToVis}}" />

                <ui:Button Content="Отмена" HorizontalAlignment="Center" Margin="0,20,0,0" MinWidth="140"
                           Command="{Binding CloseSessionCommand}"
                           AutomationProperties.Name="Отменить загрузку">
                    <ui:Button.Icon><ui:SymbolIcon Symbol="Dismiss24" /></ui:Button.Icon>
                </ui:Button>
            </StackPanel>
        </Grid>

        <!-- ============ Фаза воспроизведения ============ -->
        <!-- VideoView (HwndHost): чёрный фон, как в VideoViewerView, чтобы не мелькал белый HWND. -->
        <vlc:VideoView x:Name="Video" Background="Black"
                       Visibility="{Binding IsReadyToPlay, Converter={StaticResource BoolToVis}}">
            <Grid x:Name="Overlay" Background="#02000000">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Чёрный cover поверх нативного HWND: закрывает белый фон LibVLC
                     между остановкой vout и первым кадром (тот же приём, что в VideoViewerView). -->
                <Border x:Name="SwitchCover" Grid.Row="0" Grid.RowSpan="2" Background="Black" Visibility="Collapsed" />

                <!-- Область клика: один клик — пауза/воспроизведение, двойной — полный экран
                     (как в основном плеере). Под панелью выбора/управления в z-порядке. -->
                <Border x:Name="ClickArea" Grid.Row="0" Background="Transparent" />

                <!-- Плашка скачивания в углу: скрывается вместе с панелью (вариант А).
                     IsHitTestVisible=False — клики проходят на ClickArea (пауза). -->
                <Border x:Name="DownloadBadge" Grid.Row="0" VerticalAlignment="Top" HorizontalAlignment="Right"
                        Margin="0,14,14,0" Background="#B3000000" CornerRadius="6" Padding="10,5"
                        Visibility="Collapsed" IsHitTestVisible="False">
                    <TextBlock Text="{Binding DownloadSummaryText, Mode=OneWay}" Foreground="White"
                               FontSize="12" Opacity="0.9" />
                </Border>

                <!-- Индикатор смены скорости (как в основном плеере) -->
                <Border Grid.Row="0" HorizontalAlignment="Center" VerticalAlignment="Center"
                        Background="#AA000000" CornerRadius="10" Padding="22,12"
                        Visibility="{Binding ShowRateBadge, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="{Binding RateText}" Foreground="White" FontSize="28" FontWeight="SemiBold" />
                </Border>

                <!-- Индикатор смены громкости (как в основном плеере) -->
                <Border Grid.Row="0" HorizontalAlignment="Center" VerticalAlignment="Center"
                        Background="#AA000000" CornerRadius="10" Padding="22,12"
                        Visibility="{Binding ShowVolumeBadge, Converter={StaticResource BoolToVis}}">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon FontSize="28" Foreground="White" VerticalAlignment="Center">
                            <ui:SymbolIcon.Style>
                                <Style TargetType="ui:SymbolIcon">
                                    <Setter Property="Symbol" Value="Speaker224" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsMuted}" Value="True">
                                            <Setter Property="Symbol" Value="SpeakerMute24" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ui:SymbolIcon.Style>
                        </ui:SymbolIcon>
                        <TextBlock Text="{Binding VolumeBadgeText}" Foreground="White" FontSize="28"
                                   FontWeight="SemiBold" VerticalAlignment="Center" Margin="10,0,0,0" />
                    </StackPanel>
                </Border>

                <!-- Оверлей «Докачивается…» при перемотке за границу скачанного -->
                <StackPanel x:Name="BufferingPanel" Grid.Row="0" HorizontalAlignment="Center" VerticalAlignment="Center"
                            Visibility="Collapsed">
                    <ui:SymbolIcon Symbol="ArrowClockwise24" FontSize="40" Foreground="White" Opacity="0.8"
                                   HorizontalAlignment="Center" />
                    <TextBlock Text="Докачивается…" Foreground="White" Opacity="0.9" Margin="0,10,0,0" />
                </StackPanel>

                <!-- Ошибка воспроизведения потока -->
                <StackPanel Grid.Row="0" HorizontalAlignment="Center" VerticalAlignment="Center"
                            Visibility="{Binding IsError, Converter={StaticResource BoolToVis}}">
                    <ui:SymbolIcon Symbol="Warning24" FontSize="44" Foreground="White" Opacity="0.85"
                                   HorizontalAlignment="Center" />
                    <TextBlock Text="{Binding ErrorMessage}" Foreground="White" Opacity="0.9" Margin="0,10,0,0"
                               TextWrapping="Wrap" TextAlignment="Center" MaxWidth="420" />
                </StackPanel>

                <!-- Панель выбора (озвучка/субтитры/скорость). ВАЖНО: обычный WPF-контент внутри
                     оверлея (ForegroundWindow), а НЕ ContextMenu/Popup: Popup над airspace-окном LibVLC
                     теряет мышь при наведении и закрывается. Здесь клики работают как у обычных кнопок.
                     Позиция над кнопкой задаётся в PositionTrackPicker (HorizontalAlignment/Left + Margin). -->
                <Border x:Name="TrackPicker" Grid.Row="0" VerticalAlignment="Bottom" HorizontalAlignment="Center"
                        Margin="0,0,0,10" Background="#E61A1A1A" CornerRadius="8" Padding="6,4"
                        BorderBrush="#40FFFFFF" BorderThickness="1" Visibility="Collapsed">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="320">
                        <StackPanel x:Name="TrackPickerItems" MinWidth="250" />
                    </ScrollViewer>
                </Border>

                <!-- Панель управления -->
                <Border x:Name="ControlBar" Grid.Row="1" Background="#D91A1A1A" Padding="12,10">
                    <Grid TextElement.Foreground="White">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Play / Pause -->
                        <ui:Button Grid.Column="0" Appearance="Transparent" ToolTip="Пауза/воспроизведение (Пробел)"
                                   Command="{Binding TogglePlayPauseCommand}" VerticalAlignment="Center"
                                   AutomationProperties.Name="Пауза или воспроизведение">
                            <ui:SymbolIcon FontSize="22" Foreground="White">
                                <ui:SymbolIcon.Style>
                                    <Style TargetType="ui:SymbolIcon">
                                        <Setter Property="Symbol" Value="Play24" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                                                <Setter Property="Symbol" Value="Pause24" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ui:SymbolIcon.Style>
                            </ui:SymbolIcon>
                        </ui:Button>

                        <!-- Время -->
                        <TextBlock Grid.Column="1" VerticalAlignment="Center" Margin="8,0,10,0" FontSize="12" Opacity="0.85">
                            <Run Text="{Binding PositionMs, Mode=OneWay, Converter={StaticResource MsToTime}}" />
                            <Run Text=" / " />
                            <Run Text="{Binding LengthMs, Mode=OneWay, Converter={StaticResource MsToTime}}" />
                        </TextBlock>

                        <!-- Таймлайн (в пределах скачанного; перемотка из code-behind) -->
                        <Grid Grid.Column="2" VerticalAlignment="Center" Margin="0,0,12,0">
                            <!-- Диапазон скачанного: светлая полоса за ползунком — видно,
                                 докуда можно перемотать без ожидания и как догоняет загрузка. -->
                            <Border Height="4" CornerRadius="2" Background="#33FFFFFF" VerticalAlignment="Center">
                                <Border x:Name="DownloadedFill" Height="4" CornerRadius="2"
                                        Background="#8AFFFFFF" HorizontalAlignment="Left" Width="0" />
                            </Border>
                            <Slider x:Name="Timeline" VerticalAlignment="Center"
                                    Minimum="0" Maximum="{Binding LengthMs, Mode=OneWay}" Value="{Binding PositionMs, Mode=OneWay}"
                                    IsMoveToPointEnabled="True"
                                    Thumb.DragStarted="OnTimelineDragStarted"
                                    Thumb.DragCompleted="OnTimelineDragCompleted"
                                    PreviewMouseLeftButtonUp="OnTimelineMouseUp"
                                    AutomationProperties.Name="Таймлайн" />
                        </Grid>

                        <!-- Mute -->
                        <ui:Button Grid.Column="3" Appearance="Transparent" ToolTip="Звук (M)" Margin="4,0,0,0"
                                   Command="{Binding ToggleMuteCommand}" VerticalAlignment="Center"
                                   AutomationProperties.Name="Выключить или включить звук">
                            <ui:SymbolIcon FontSize="22" Foreground="White">
                                <ui:SymbolIcon.Style>
                                    <Style TargetType="ui:SymbolIcon">
                                        <Setter Property="Symbol" Value="Speaker224" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsMuted}" Value="True">
                                                <Setter Property="Symbol" Value="SpeakerMute24" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ui:SymbolIcon.Style>
                            </ui:SymbolIcon>
                        </ui:Button>

                        <!-- Громкость − / + -->
                        <ui:Button Grid.Column="4" Appearance="Transparent" ToolTip="Громкость ниже (↓)" Margin="4,0,0,0"
                                   Command="{Binding VolumeDownCommand}" VerticalAlignment="Center"
                                   AutomationProperties.Name="Громкость ниже">
                            <ui:Button.Icon>
                                <ui:SymbolIcon Symbol="Subtract24" FontSize="22" Foreground="White" />
                            </ui:Button.Icon>
                        </ui:Button>
                        <ui:Button Grid.Column="5" Appearance="Transparent" ToolTip="Громкость выше (↑)"
                                   Command="{Binding VolumeUpCommand}" VerticalAlignment="Center"
                                   AutomationProperties.Name="Громкость выше">
                            <ui:Button.Icon>
                                <ui:SymbolIcon Symbol="Add24" FontSize="22" Foreground="White" />
                            </ui:Button.Icon>
                        </ui:Button>

                        <!-- Озвучка (список доступен после старта — строится по клику) -->
                        <ui:Button x:Name="AudioButton" Grid.Column="6" Appearance="Transparent"
                                   ToolTip="Аудиодорожка" Click="OnAudioButtonClick" Margin="4,0,0,0"
                                   VerticalAlignment="Center" AutomationProperties.Name="Аудиодорожка">
                            <ui:Button.Icon>
                                <ui:SymbolIcon Symbol="MusicNote124" FontSize="22" Foreground="White" />
                            </ui:Button.Icon>
                        </ui:Button>

                        <!-- Субтитры (встроенные + внешний файл) -->
                        <ui:Button x:Name="SubtitleButton" Grid.Column="7" Appearance="Transparent"
                                   ToolTip="Субтитры" Click="OnSubtitleButtonClick" Margin="4,0,0,0"
                                   VerticalAlignment="Center" AutomationProperties.Name="Субтитры">
                            <ui:Button.Icon>
                                <ui:SymbolIcon Symbol="ClosedCaption24" FontSize="22" Foreground="White" />
                            </ui:Button.Icon>
                        </ui:Button>

                        <!-- Скорость (цикл + меню) -->
                        <ui:Button x:Name="SpeedButton" Grid.Column="8" Appearance="Transparent"
                                   ToolTip="Скорость воспроизведения" Click="OnSpeedButtonClick" Margin="6,0,0,0"
                                   Content="{Binding RateText}" VerticalAlignment="Center"
                                   AutomationProperties.Name="Скорость воспроизведения">
                            <ui:Button.Icon><ui:SymbolIcon Symbol="TopSpeed24" FontSize="22" Foreground="White" /></ui:Button.Icon>
                        </ui:Button>

                        <!-- Полный экран -->
                        <ui:Button Grid.Column="9" Appearance="Transparent" ToolTip="Полный экран"
                                   Command="{Binding ToggleFullScreenCommand}" VerticalAlignment="Center"
                                   AutomationProperties.Name="Полный экран">
                            <ui:Button.Icon>
                                <ui:SymbolIcon Symbol="FullScreenMaximize24" FontSize="22" Foreground="White" />
                            </ui:Button.Icon>
                        </ui:Button>

                        <!-- Закрыть сессию -->
                        <ui:Button Grid.Column="10" Appearance="Transparent" ToolTip="Закрыть стриминг (Esc)"
                                   Command="{Binding CloseSessionCommand}" VerticalAlignment="Center"
                                   AutomationProperties.Name="Закрыть стриминг">
                            <ui:Button.Icon>
                                <ui:SymbolIcon Symbol="Dismiss24" FontSize="22" Foreground="White" />
                            </ui:Button.Icon>
                        </ui:Button>
                    </Grid>
                </Border>
            </Grid>
        </vlc:VideoView>
    </Grid>
</UserControl>
