<UserControl x:Class="Prosmotr.Views.VideoViewerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF"
             xmlns:ctl="clr-namespace:Prosmotr.Views.Controls"
             xmlns:vm="clr-namespace:Prosmotr.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:VideoViewerViewModel}">

    <!-- Фон VideoHost всегда чёрный: в светлой теме AppCanvasBrush = белый,
         и любой зазор между нативным окном LibVLC и WPF-контейнером выглядел
         бы как белая полоса/квадрат справа/снизу. ClipToBounds оставляем;
         UseLayoutRounding/SnapsToDevicePixels убраны — они дают рассинхрон
         DIP-пикселей WPF и физических пикселей HWND при airspace LibVLC. -->
    <Grid x:Name="VideoHost" Background="Black" ClipToBounds="True">
        <!-- VideoView (HwndHost + нативное HWND VLC): явный чёрный фон,
             чтобы между сменой Media или при инициализации не мелькал белый HWND. -->
        <vlc:VideoView x:Name="Video" Background="Black">
            <!-- ВАЖНО (airspace): контролы лежат ВНУТРИ VideoView как его Content,
                 а фон оверлея НЕ полностью прозрачный (#01000000) — иначе не ловятся клики. -->
            <Grid x:Name="Overlay" Background="#02000000">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Область клика: один клик — пауза/воспроизведение, двойной — полный экран -->
                <Border x:Name="ClickArea" Grid.Row="0" Background="Transparent" />

                <!-- Инфо-плашка в полноэкранном режиме (замена верхней панели Toolbar) -->
                <Border x:Name="FullscreenInfoBorder" Grid.Row="0" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,14,0,0"
                        Background="#D91A1A1A" CornerRadius="6" Padding="14,6"
                        IsHitTestVisible="False" Visibility="Collapsed">
                    <TextBlock x:Name="InfoText" Foreground="White" FontSize="13" Opacity="0.9" />
                </Border>

                <!-- Индикатор смены скорости -->
                <Border Grid.Row="0" HorizontalAlignment="Center" VerticalAlignment="Center"
                        Background="#AA000000" CornerRadius="10" Padding="22,12"
                        Visibility="{Binding ShowRateBadge, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="{Binding RateText}" Foreground="White" FontSize="28" FontWeight="SemiBold" />
                </Border>

                <!-- Кнопка повтора по окончании -->
                <ui:Button Grid.Row="0" HorizontalAlignment="Center" VerticalAlignment="Center"
                           Appearance="Primary" Command="{Binding TogglePlayCommand}"
                           Visibility="{Binding IsEnded, Converter={StaticResource BoolToVis}}"
                           Content="Повторить">
                    <ui:Button.Icon><ui:SymbolIcon Symbol="ArrowCounterclockwise24" /></ui:Button.Icon>
                </ui:Button>

                <!-- Переключение файлов по бокам: показываются при нескольких файлах ВМЕСТЕ с панелью
                     управления — прячутся по таймеру одновременно с ней (видимостью управляет code-behind). -->
                <Button x:Name="PrevFileButton" Grid.Row="0" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="20,0,0,0"
                        Width="52" Height="52" Style="{StaticResource OverlayButton}" Click="OnPrevFileClick"
                        Visibility="Collapsed" ToolTip="Предыдущий файл (←)"
                        AutomationProperties.Name="Предыдущий файл">
                    <ui:SymbolIcon Symbol="ChevronLeft24" FontSize="22" />
                </Button>
                <Button x:Name="NextFileButton" Grid.Row="0" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,20,0"
                        Width="52" Height="52" Style="{StaticResource OverlayButton}" Click="OnNextFileClick"
                        Visibility="Collapsed" ToolTip="Следующий файл (→)"
                        AutomationProperties.Name="Следующий файл">
                    <ui:SymbolIcon Symbol="ChevronRight24" FontSize="22" />
                </Button>

                <!-- Ошибка -->
                <StackPanel Grid.Row="0" HorizontalAlignment="Center" VerticalAlignment="Center"
                            Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}">
                    <ui:SymbolIcon Symbol="Warning24" FontSize="48" Foreground="White" Opacity="0.8"
                                   HorizontalAlignment="Center" />
                    <TextBlock Text="Не удалось воспроизвести видео" Foreground="White" Margin="0,8,0,0" />
                </StackPanel>

                <!-- Панель управления -->
                <Border x:Name="ControlBar" Grid.Row="1" Background="#D91A1A1A" Padding="12,10">
                    <Grid TextElement.Foreground="White">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Play / Pause -->
                        <ui:Button Grid.Column="0" Appearance="Transparent" Command="{Binding TogglePlayCommand}"
                                   ToolTip="Воспроизведение / пауза (Пробел)"
                                   AutomationProperties.Name="Воспроизведение / пауза">
                            <ui:SymbolIcon Foreground="White">
                                <ui:SymbolIcon.Style>
                                    <Style TargetType="ui:SymbolIcon">
                                        <Setter Property="Symbol" Value="Play24" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                                                <Setter Property="Symbol" Value="Pause24" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ui:SymbolIcon.Style>
                            </ui:SymbolIcon>
                        </ui:Button>

                        <!-- Текущее время -->
                        <TextBlock Grid.Column="1" VerticalAlignment="Center" Margin="6,0"
                                   Text="{Binding PositionMs, Converter={StaticResource MsToTime}}" />

                        <!-- Таймлайн -->
                        <Slider x:Name="PositionSlider" Grid.Column="2" VerticalAlignment="Center"
                                Minimum="0" Maximum="{Binding LengthMs}" IsMoveToPointEnabled="True"
                                Margin="8,0" />

                        <!-- Длительность -->
                        <TextBlock Grid.Column="3" VerticalAlignment="Center" Margin="6,0"
                                   Text="{Binding LengthMs, Converter={StaticResource MsToTime}}" />

                        <!-- Mute -->
                        <ui:Button Grid.Column="4" Appearance="Transparent" Command="{Binding ToggleMuteCommand}"
                                   ToolTip="Звук (M)"
                                   AutomationProperties.Name="Звук">
                            <ui:SymbolIcon Foreground="White">
                                <ui:SymbolIcon.Style>
                                    <Style TargetType="ui:SymbolIcon">
                                        <Setter Property="Symbol" Value="Speaker224" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsMuted}" Value="True">
                                                <Setter Property="Symbol" Value="SpeakerMute24" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ui:SymbolIcon.Style>
                            </ui:SymbolIcon>
                        </ui:Button>

                        <!-- Громкость (с усилением до 300%); метка на 100% = «нормально» -->
                        <Slider Grid.Column="5" Width="80" VerticalAlignment="Center"
                                Minimum="0" Maximum="{Binding MaxVolume}" Value="{Binding Volume, Mode=TwoWay}"
                                SmallChange="5" LargeChange="10" Ticks="100" TickPlacement="BottomRight"
                                ToolTip="Громкость / усиление до 300% (↑/↓)" Margin="4,0,2,0" />

                        <!-- Текущая громкость в процентах -->
                        <TextBlock Grid.Column="6" VerticalAlignment="Center" MinWidth="40" Margin="0,0,6,0"
                                   TextAlignment="Right" FontSize="12"
                                   Text="{Binding Volume, StringFormat={}{0}%}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="White" />
                                    <Style.Triggers>
                                        <!-- Подсветим, когда включено усиление выше 100% -->
                                        <DataTrigger Binding="{Binding IsBoosted}" Value="True">
                                            <Setter Property="Foreground" Value="#FFC53B" />
                                            <Setter Property="FontWeight" Value="SemiBold" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <!-- Аудиодорожка -->
                        <ui:Button x:Name="AudioButton" Grid.Column="7" Appearance="Transparent"
                                   Click="OnAudioButtonClick" ToolTip="Аудиодорожка"
                                   AutomationProperties.Name="Аудиодорожка">
                            <ui:SymbolIcon Symbol="MusicNote124" Foreground="White" />
                        </ui:Button>

                        <!-- Субтитры -->
                        <ui:Button x:Name="SubtitleButton" Grid.Column="8" Appearance="Transparent"
                                   Click="OnSubtitleButtonClick" ToolTip="Субтитры"
                                   AutomationProperties.Name="Субтитры">
                            <ui:SymbolIcon Symbol="ClosedCaption24" Foreground="White" />
                        </ui:Button>

                        <!-- Снимок кадра -->
                        <ui:Button Grid.Column="9" Appearance="Transparent"
                                   Command="{Binding TakeSnapshotCommand}" ToolTip="Сохранить кадр"
                                   AutomationProperties.Name="Сохранить кадр">
                            <ui:SymbolIcon Symbol="Camera24" Foreground="White" />
                        </ui:Button>

                        <!-- Скорость: иконка внутри кнопки + текущее значение; по клику меню -->
                        <ui:Button x:Name="SpeedButton" Grid.Column="10" Appearance="Transparent"
                                   Foreground="White" Margin="4,0,2,0" MinWidth="48"
                                   Content="{Binding RateText}" Click="OnSpeedButtonClick"
                                   ToolTip="Скорость воспроизведения ([ / ])"
                                   AutomationProperties.Name="Скорость воспроизведения">
                            <ui:Button.Icon><ui:SymbolIcon Symbol="TopSpeed24" Foreground="White" /></ui:Button.Icon>
                        </ui:Button>

                        <!-- Полный экран -->
                        <ui:Button Grid.Column="11" Appearance="Transparent" Click="OnFullScreenClick"
                                   ToolTip="Полный экран (F)"
                                   AutomationProperties.Name="Полный экран">
                            <ui:SymbolIcon Symbol="FullScreenMaximize24" Foreground="White" />
                        </ui:Button>

                        <!-- Picture-in-Picture -->
                        <ui:Button Grid.Column="12" Appearance="Transparent" Click="OnPictureInPictureClick"
                                   ToolTip="Окно в окне (P)" MinWidth="28"
                                   AutomationProperties.Name="Окно в окне">
                            <Viewbox Width="18" Height="18">
                                <Path Fill="White"
                                      Data="M1,2 L15,2 L15,11 L1,11 Z M17,6 L23,6 L23,22 L7,22 L7,13 L17,13 Z M8,14 L22,14 L22,21 L8,21 Z" />
                            </Viewbox>
                        </ui:Button>

                        <!-- Дублирование экрана -->
                        <ui:Button x:Name="CloneDisplayButton" Grid.Column="13" Appearance="Transparent"
                                   Click="OnCloneDisplayClick"
                                   ToolTip="Дублировать на экран (F12)"
                                   Visibility="Collapsed"
                                   AutomationProperties.Name="Дублировать на экран">
                            <ui:SymbolIcon Symbol="Desktop24" Foreground="White" />
                        </ui:Button>
                    </Grid>
                </Border>

                <!-- Мини-таймлайн: тонкий прогресс при скрытой панели управления.
                     IsHitTestVisible=False, чтобы клики проходили на ClickArea (пауза/полный экран).
                     Видимостью управляет code-behind (UpdateChromeVisibility). -->
                <ProgressBar x:Name="MiniTimeline"
                            Grid.Row="1"
                            VerticalAlignment="Bottom"
                            HorizontalAlignment="Stretch"
                            Height="4"
                            Minimum="0"
                            Maximum="{Binding LengthMs}"
                            Value="{Binding PositionMs}"
                            Background="#55000000"
                            Foreground="White"
                            IsHitTestVisible="False"
                            Visibility="Collapsed" />

                <!-- Чёрный cover на время загрузки первого кадра (старт/переключение видео):
                     нативное Win32-окно LibVLC (HwndHost, класс "static") до отрисовки первого
                     кадра закрашивается своим светлым фоном — отсюда белый квадрат при смене
                     видео. WPF-фон VideoView/VideoHost этого не лечит: он за непрозрачным HWND.
                     Cover лежит в оверлее (ForegroundWindow всегда поверх нативного окна) и
                     гарантированно перекрывает белый. RowSpan="2" + скрытие панели во время
                     буферизации, чтобы белый фон не просвечивал ни в какой области, включая
                     полупрозрачную панель управления. Убирается, когда первый кадр готов
                     (IsBuffering → false). -->
                <Border x:Name="SwitchCover" Grid.Row="0" Grid.RowSpan="2" Background="Black"
                        IsHitTestVisible="False"
                        Visibility="{Binding IsBuffering, Converter={StaticResource BoolToVis}}" />

                <!-- Уведомления поверх видео (внутри airspace VLC — иначе тосты не видны на видео) -->
                <ctl:ToastView Grid.Row="0" />
            </Grid>
        </vlc:VideoView>
    </Grid>
</UserControl>
