<ui:FluentWindow x:Class="Prosmotr.Views.MagnetInputWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="Магнет-стриминг"
                 Width="580" SizeToContent="Height"
                 WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
                 ExtendsContentIntoTitleBar="True">

    <StackPanel Margin="28,8,28,24">
        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
            <ui:SymbolIcon Symbol="Link24" FontSize="20" Opacity="0.8" VerticalAlignment="Center" Margin="0,0,10,0" />
            <TextBlock Text="Вставьте магнет-ссылку" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
        </StackPanel>
        <TextBlock Text="Видео начнёт играть по мере загрузки; файл сохранится в кэше и будет раздаваться, пока приложение открыто."
                   Opacity="0.7" TextWrapping="Wrap" FontSize="12" Margin="0,0,0,10" />
        <TextBox x:Name="MagnetBox" Height="64" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                 VerticalContentAlignment="Top" AcceptsReturn="False"
                 AutomationProperties.Name="Магнет-ссылка" />
        <TextBlock x:Name="ErrorText" Foreground="#FF8F8F" FontSize="12" Margin="0,6,0,0" Visibility="Collapsed" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <ui:Button Content="Отмена" MinWidth="100" Click="OnCancel"
                       AutomationProperties.Name="Отмена" />
            <ui:Button Content="Смотреть" Appearance="Primary" MinWidth="120" Margin="10,0,0,0"
                       Click="OnOk" AutomationProperties.Name="Смотреть">
                <ui:Button.Icon><ui:SymbolIcon Symbol="Play24" /></ui:Button.Icon>
            </ui:Button>
        </StackPanel>
    </StackPanel>
</ui:FluentWindow>
