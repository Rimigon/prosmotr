<ui:FluentWindow x:Class="Prosmotr.Views.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:views="clr-namespace:Prosmotr.Views"
                 xmlns:ctl="clr-namespace:Prosmotr.Views.Controls"
                 xmlns:vm="clr-namespace:Prosmotr.ViewModels"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 mc:Ignorable="d"
                 d:DataContext="{d:DesignInstance vm:MainViewModel}"
                 Title="{Binding CurrentFileName}"
                 Icon="pack://application:,,,/Resources/Icons/app.ico"
                 Width="1180" Height="760" MinWidth="640" MinHeight="420"
                 WindowState="Maximized"
                 WindowStartupLocation="CenterScreen"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="None"
                 Background="{DynamicResource AppCanvasBrush}"
                 AllowDrop="True">

    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:ImageViewerViewModel}">
            <views:ImageViewerView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:VideoViewerViewModel}">
            <views:VideoViewerView />
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Заголовок окна -->
        <ui:TitleBar x:Name="AppTitleBar" Grid.Row="0" Title="Просмотр"
                     Visibility="{Binding IsFullScreen, Converter={StaticResource InverseBoolToVis}}" />

        <!-- Командная панель -->
        <Border x:Name="Toolbar" Grid.Row="1" Padding="10,4"
                Visibility="{Binding IsFullScreen, Converter={StaticResource InverseBoolToVis}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Слева: открытие + сортировка -->
                <StackPanel Orientation="Horizontal">
                    <ui:Button Appearance="Transparent" ToolTip="Открыть файл" Command="{Binding OpenFileCommand}">
                        <ui:Button.Icon><ui:SymbolIcon Symbol="Document24" Foreground="{DynamicResource AppCanvasForeground}" /></ui:Button.Icon>
                    </ui:Button>
                    <ui:Button Appearance="Transparent" ToolTip="Открыть папку" Command="{Binding OpenFolderCommand}">
                        <ui:Button.Icon><ui:SymbolIcon Symbol="FolderOpen24" Foreground="{DynamicResource AppCanvasForeground}" /></ui:Button.Icon>
                    </ui:Button>

                    <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" Margin="8,4" />

                    <ui:SymbolIcon Symbol="ArrowSort24" VerticalAlignment="Center" Opacity="0.7" Margin="0,0,4,0" FontSize="15" />
                    <ComboBox Width="118" Height="30" VerticalAlignment="Center" FontSize="12" Padding="8,0"
                              HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                              Background="{DynamicResource AppCanvasBrush}"
                              ItemsSource="{Binding SortFields}" SelectedItem="{Binding SelectedSortField}"
                              ToolTip="Поле сортировки">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Converter={StaticResource SortFieldToString}}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <ui:Button Appearance="Transparent" Command="{Binding ToggleSortDirectionCommand}"
                               ToolTip="Направление сортировки">
                        <ui:SymbolIcon>
                            <ui:SymbolIcon.Style>
                                <Style TargetType="ui:SymbolIcon">
                                    <Setter Property="Foreground" Value="{DynamicResource AppCanvasForeground}" />
                                    <Setter Property="Symbol" Value="ArrowUp24" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SortDescending}" Value="True">
                                            <Setter Property="Symbol" Value="ArrowDown24" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ui:SymbolIcon.Style>
                        </ui:SymbolIcon>
                    </ui:Button>
                </StackPanel>

                <!-- Центр: статус -->
                <TextBlock Grid.Column="1" Text="{Binding StatusText}" Opacity="0.75"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />

                <!-- Справа: действия -->
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <ui:Button Appearance="Transparent" ToolTip="Слайд-шоу" Command="{Binding ToggleSlideshowCommand}">
                        <ui:Button.Icon><ui:SymbolIcon Symbol="Play24" Foreground="{DynamicResource AppCanvasForeground}" /></ui:Button.Icon>
                    </ui:Button>
                    <ui:Button Appearance="Transparent" ToolTip="Показать в проводнике" Command="{Binding ShowInExplorerCommand}">
                        <ui:Button.Icon><ui:SymbolIcon Symbol="FolderArrowRight24" Foreground="{DynamicResource AppCanvasForeground}" /></ui:Button.Icon>
                    </ui:Button>
                    <ui:Button Appearance="Transparent" ToolTip="Копировать путь" Command="{Binding CopyPathCommand}">
                        <ui:Button.Icon><ui:SymbolIcon Symbol="Copy24" Foreground="{DynamicResource AppCanvasForeground}" /></ui:Button.Icon>
                    </ui:Button>
                    <ui:Button Appearance="Transparent" ToolTip="Открыть с помощью…" Command="{Binding OpenWithCommand}">
                        <ui:Button.Icon><ui:SymbolIcon Symbol="Apps24" Foreground="{DynamicResource AppCanvasForeground}" /></ui:Button.Icon>
                    </ui:Button>
                    <ui:Button Appearance="Transparent" ToolTip="Свойства файла" Command="{Binding ShowPropertiesCommand}">
                        <ui:Button.Icon><ui:SymbolIcon Symbol="Info24" Foreground="{DynamicResource AppCanvasForeground}" /></ui:Button.Icon>
                    </ui:Button>

                    <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" Margin="8,4" />

                    <ui:Button Appearance="Transparent" ToolTip="Восстановить удаление"
                               Command="{Binding RestoreLastDeleteCommand}">
                        <ui:Button.Icon><ui:SymbolIcon Symbol="ArrowHookUpLeft24" Foreground="{DynamicResource AppCanvasForeground}" /></ui:Button.Icon>
                    </ui:Button>
                    <ui:Button Appearance="Transparent" ToolTip="Удалить (Delete)" Command="{Binding DeleteCommand}">
                        <ui:Button.Icon><ui:SymbolIcon Symbol="Delete24" Foreground="{DynamicResource AppCanvasForeground}" /></ui:Button.Icon>
                    </ui:Button>
                    <ui:Button Appearance="Transparent" ToolTip="Полный экран (F11 / F)" Command="{Binding ToggleFullScreenCommand}">
                        <ui:Button.Icon><ui:SymbolIcon Symbol="FullScreenMaximize24" Foreground="{DynamicResource AppCanvasForeground}" /></ui:Button.Icon>
                    </ui:Button>
                    <ui:Button Appearance="Transparent" ToolTip="Настройки" Command="{Binding OpenSettingsCommand}">
                        <ui:Button.Icon><ui:SymbolIcon Symbol="Settings24" Foreground="{DynamicResource AppCanvasForeground}" /></ui:Button.Icon>
                    </ui:Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Основная область: лента + контент. Фон по теме (чёрный/белый) — без дефектов при ресайзе. -->
        <Grid Grid.Row="2" Background="{DynamicResource AppCanvasBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Контент (фото / видео / пусто).
                 Явный фон закрывает возможный белый промежуток между сменой View
                 (особенно при уничтожении/создании нативного VideoView HWND). -->
            <ContentControl x:Name="ContentHost" Grid.Row="0" Grid.Column="1"
                            Content="{Binding CurrentContent}"
                            Background="{DynamicResource AppCanvasBrush}" />

            <!-- Инфо-плашка в полноэкранном режиме (замена верхней панели Toolbar) -->
            <Border Grid.Row="0" Grid.Column="1" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,14,0,0"
                    Background="#D91A1A1A" CornerRadius="6" Padding="14,6"
                    IsHitTestVisible="False"
                    Visibility="{Binding ShowFullscreenInfo, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="{Binding StatusText}" Foreground="White" FontSize="13" Opacity="0.9" />
            </Border>

            <!-- Стрелки навигации (собственный стиль — видны во всех состояниях) -->
            <Button Grid.Row="0" Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="14,0,0,0"
                    Style="{StaticResource AutoHideNavArrow}" Command="{Binding PreviousCommand}"
                    Visibility="{Binding ShowWindowNavArrows, Converter={StaticResource BoolToVis}}"
                    ToolTip="Назад (←)">
                <ui:SymbolIcon Symbol="ChevronLeft24" FontSize="20" Foreground="{DynamicResource AppCanvasForeground}" />
            </Button>
            <Button Grid.Row="0" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,14,0"
                    Style="{StaticResource AutoHideNavArrow}" Command="{Binding NextCommand}"
                    Visibility="{Binding ShowWindowNavArrows, Converter={StaticResource BoolToVis}}"
                    ToolTip="Вперёд (→)">
                <ui:SymbolIcon Symbol="ChevronRight24" FontSize="20" Foreground="{DynamicResource AppCanvasForeground}" />
            </Button>

            <!-- Лента миниатюр (положение задаётся в коде по настройке) -->
            <views:ThumbnailStripView x:Name="Strip" Grid.Row="1" Grid.Column="1"
                                      DataContext="{Binding ThumbnailStrip}"
                                      Visibility="{Binding DataContext.ShowThumbnailStrip,
                                                   RelativeSource={RelativeSource AncestorType=Window},
                                                   Converter={StaticResource BoolToVis}}"
                                      Height="92" />

            <!-- Уведомления (свой тост; для фото/пустого экрана — поверх контента сверху по центру) -->
            <ctl:ToastView Grid.Row="0" Grid.RowSpan="2" Grid.Column="0" Grid.ColumnSpan="2" />
        </Grid>
    </Grid>
</ui:FluentWindow>
