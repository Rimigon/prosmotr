<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>

    <!-- Принудительно 64-битный процесс: нативные плагины LibVLC грузятся из libvlc\win-x64.
         Платформу решения держим Any CPU (проще для CLI/VS), а компилируем под x64. -->
    <PlatformTarget>x64</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>

    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Resources\Icons\app.ico</ApplicationIcon>
    <AssemblyName>Prosmotr</AssemblyName>
    <RootNamespace>Prosmotr</RootNamespace>
    <Product>Просмотр</Product>
    <AssemblyTitle>Просмотр — просмотрщик фото и видео</AssemblyTitle>
    <Version>1.0.0</Version>

    <!-- ВАЖНО: single-file publish ломает нативные плагины LibVLC, поэтому не включаем. -->
    <PublishReadyToRun>true</PublishReadyToRun>
    <!-- Композитный R2R: один большой нативный образ вместо множества мелких —
         меньше page faults и остаточной JIT при холодном старте. -->
    <PublishReadyToRunComposite>true</PublishReadyToRunComposite>
    <SatelliteResourceLanguages>en;ru</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <!-- UI / MVVM / DI -->
    <PackageReference Include="WPF-UI" Version="4.3.0" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="8.0.1" />

    <!-- Видео: LibVLC играет все форматы без доустановки системных кодеков -->
    <PackageReference Include="LibVLCSharp" Version="3.9.7.1" />
    <PackageReference Include="LibVLCSharp.WPF" Version="3.9.7.1" />
    <PackageReference Include="VideoLAN.LibVLC.Windows" Version="3.0.23.1" />

    <!-- Изображения: WEBP/HEIC через Magick.NET, анимированный GIF через XamlAnimatedGif -->
    <PackageReference Include="Magick.NET-Q8-AnyCPU" Version="14.13.1" />
    <PackageReference Include="XamlAnimatedGif" Version="2.3.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- Иконка окна (через pack://...): доступна как ресурс сборки -->
    <Resource Include="Resources\Icons\app.ico" />
  </ItemGroup>

</Project>
