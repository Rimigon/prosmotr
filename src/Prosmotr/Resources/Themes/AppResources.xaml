<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:conv="clr-namespace:Prosmotr.Converters"
                    xmlns:vm="clr-namespace:Prosmotr.ViewModels"
                    xmlns:views="clr-namespace:Prosmotr.Views">

    <!-- Фон/текст «холста», зависящие от темы (обновляются в ThemeService):
         тёмная — чёрный фон/белый текст; светлая — белый фон/чёрный текст. -->
    <SolidColorBrush x:Key="AppCanvasBrush" Color="Black" />
    <SolidColorBrush x:Key="AppCanvasForeground" Color="White" />
    <!-- Полупрозрачная подсветка для кнопок поверх «холста», чтобы они не сливались с фоном -->
    <SolidColorBrush x:Key="AppOverlayBrush" Color="#33FFFFFF" />

    <!-- Круглая кнопка-оверлей поверх медиа: своя отрисовка, видна во всех состояниях. -->
    <Style x:Key="OverlayButton" TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource AppCanvasForeground}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Width" Value="48" />
        <Setter Property="Height" Value="48" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid Background="Transparent">
                        <Ellipse x:Name="Bg" Fill="{DynamicResource AppOverlayBrush}" Opacity="0.55" />
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          TextElement.Foreground="{TemplateBinding Foreground}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Opacity" Value="0.9" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bg" Property="Opacity" Value="1" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Стрелка навигации: видна всегда (в окне и в полном экране), ярче при наведении. -->
    <Style x:Key="AutoHideNavArrow" TargetType="Button" BasedOn="{StaticResource OverlayButton}">
        <Setter Property="Opacity" Value="0.5" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Opacity" Value="1" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Конвертеры -->
    <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis" />
    <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
    <conv:BoolAndToVisibilityConverter x:Key="BoolAndToVis" />
    <conv:NullToVisibilityConverter x:Key="NullToVis" />
    <conv:MillisecondsToTimeConverter x:Key="MsToTime" />
    <conv:PlaybackRateToStringConverter x:Key="RateToString" />
    <conv:ThemeToStringConverter x:Key="ThemeToString" />
    <conv:StripPositionToStringConverter x:Key="StripPositionToString" />
    <conv:SortFieldToStringConverter x:Key="SortFieldToString" />
    <conv:EqualityConverter x:Key="Equality" />

    <!-- Сопоставление ViewModel → View (автоприменяется через ContentControl) -->
    <DataTemplate DataType="{x:Type vm:EmptyStateViewModel}">
        <views:EmptyStateView />
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:ImageViewerViewModel}">
        <views:ImageViewerView />
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:VideoViewerViewModel}">
        <views:VideoViewerView />
    </DataTemplate>

</ResourceDictionary>
